{
  "format": "2",
  "description": "Deterministic source-selection policy for generated project context.",
  "includeExtensions": [
    ".md",
    ".txt",
    ".json",
    ".yaml",
    ".yml",
    ".toml",
    ".rs",
    ".ts",
    ".tsx",
    ".js",
    ".jsx",
    ".py",
    ".sh",
    ".sql",
    ".c",
    ".h",
    ".cpp",
    ".hpp",
    ".proto",
    ".graphql",
    ".css",
    ".html"
  ],
  "excludeDirectories": [
    ".git",
    "node_modules",
    "target",
    "dist",
    "build",
    "out",
    "coverage",
    "htmlcov",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".next",
    ".turbo",
    ".vercel",
    "tmp",
    "temp",
    ".venv",
    ".cache",
    "release",
    ".formal-bootstrap"
  ],
  "excludePaths": [
    ".agents/llms.txt",
    ".agents/llms-full.txt",
    ".agents/llms-fpb.txt",
    ".agents/llms-full-fpb.txt",
    ".agents/context-lock.json",
    "PACKAGE_MANIFEST.json",
    ".env",
    ".env.local"
  ],
  "excludePatterns": [
    "*.tmp",
    "*.temp",
    "*.bak",
    "*~",
    "*.pyc",
    "*.pyo",
    "*.tsbuildinfo",
    "*.log",
    "*.swp",
    "*.swo",
    "*.orig",
    "*.rej",
    "llm-full-docs*.txt",
    "llms*.txt",
    "llm-full-docs*/**",
    ".agents/thread/**",
    ".env.*",
    "*.pem",
    "*.key",
    "*.p12",
    "*.pfx",
    "*credentials*.json",
    "*secrets*.json"
  ],
  "maxFileBytes": 1048576,
  "maxTotalBytes": 16777216,
  "includeVendor": true,
  "note": "Full corpus is for deterministic search/transport. Active worker context should still be issue-bounded.",
  "includeFiles": [
    "VERSION"
  ]
}
