#!/usr/bin/env python3
"""acp -- the ACP client for this project.

    .agents/acp/acp status        is everything set up and current? (one line per check, with the fix)
    .agents/acp/acp init          generate or refresh the project's ACP settings
    .agents/acp/acp push          publish a commit through ACP, one exact approval per step
    .agents/acp/acp authorize …   one decision for one governed effect
    .agents/acp/acp --help        every command

Standard library only; Python 3.11 or newer.
"""
import sys

if sys.version_info < (3, 11):
    sys.exit(f"acp needs Python 3.11 or newer; this is {sys.version.split()[0]}")

from pathlib import Path

sys.dont_write_bytecode = True

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import acp  # noqa: E402

raise SystemExit(acp.main())
