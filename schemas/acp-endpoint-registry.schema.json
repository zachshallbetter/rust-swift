{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formal-project-bootstrap.dev/schema/acp-endpoint-registry.schema.json",
  "title": "Machine-local ACP endpoint registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "endpointSets"],
  "properties": {
    "formatVersion": {"const": 1},
    "endpointSets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "url", "keychainAccount", "localOnly"],
          "properties": {
            "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"},
            "url": {"type": "string", "minLength": 1, "maxLength": 2048},
            "keychainAccount": {"type": "string", "pattern": "^ACP_GATEWAY_TOKEN(?:_[A-Z0-9_]+)?$"},
            "localOnly": {"type": "boolean"},
            "stateAuthorityId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"}
          }
        }
      }
    }
  }
}
